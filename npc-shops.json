---
layout: null
permalink: /npc-shops.json
sitemap: false
---
{% include shops-sorted.html %}
[
{%- for shop in sorted_shops -%}
  {%- assign raw = shop.content -%}
  {%- assign is_html = false -%}
  {%- if raw contains "<td" -%}{%- assign is_html = true -%}{%- endif -%}
  {
    "title": {{ shop.title | jsonify }},
    "url": {{ shop.url | relative_url | jsonify }},
    "description": {{ shop.description | default: "" | jsonify }},
    "icon": {{ shop.icon | default: "fa-store" | jsonify }},
    "items": [
      {%- if is_html -%}
        {%- assign rows = raw | split: "<tr" -%}
        {%- assign first = true -%}
        {%- for row in rows -%}
          {%- assign cells = row | split: "<td" -%}
          {%- if cells.size > 1 -%}
            {%- assign item = cells[1] | remove_first: ">" | split: "</td" | first | strip_html | strip -%}
            {%- if item != "" -%}
              {%- unless first -%},{%- endunless -%}
              {{ item | jsonify }}
              {%- assign first = false -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign lines = raw | newline_to_br | split: "<br />" -%}
        {%- assign first = true -%}
        {%- for line in lines -%}
          {%- assign t = line | strip -%}
          {%- assign fc = t | slice: 0 -%}
          {%- if fc == "|" -%}
            {%- assign cleaned = t | remove: "|" | remove: "-" | remove: ":" | strip -%}
            {%- if cleaned != "" -%}
              {%- assign cells = t | split: "|" -%}
              {%- assign item = cells[1] | default: "" | strip -%}
              {%- if item != "" and item != "Item Name" -%}
                {%- unless first -%},{%- endunless -%}
                {{ item | jsonify }}
                {%- assign first = false -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    ]
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]